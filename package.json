{
	"name": "detcord",
	"version": "1.0.2",
	"description": "Bulk delete your own Discord messages - Fast, secure, privacy-focused",
	"author": "Alex Howells <alex@welshwandering.com> (https://welshwandering.com)",
	"license": "MIT",
	"keywords": [
		"discord",
		"userscript",
		"tampermonkey",
		"greasemonkey",
		"violentmonkey",
		"bulk-delete",
		"message-delete",
		"privacy",
		"discord-messages",
		"discord-cleaner"
	],
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/canaryframe/detcord"
	},
	"scripts": {
		"build": "vite build",
		"build:userscript": "vite build --mode userscript",
		"dev": "vite",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^26.5.0",
		"@vitest/coverage-v8": "^5.0.0",
		"jsdom": "^30.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
